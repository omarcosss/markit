# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=sqlite:///./bookmarks.db

# Session length in minutes (default 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173

# Send the session cookie only over HTTPS (set to false only for plain-HTTP local dev)
COOKIE_SECURE=true

# Interactive API docs at /docs (keep disabled in production)
ENABLE_DOCS=false
